# =============================================================================
# Nova Vida — variáveis de ambiente (SEM valores reais)
# Copie para .env.local / secrets da Vercel conforme o ambiente.
# =============================================================================

# URL canônica pública (produção atual). Override opcional.
# NEXT_PUBLIC_SITE_URL=https://novavida-navy.vercel.app
# CANONICAL_SITE_URL=https://novavida-navy.vercel.app

# URL do ambiente atual (local / preview / produção)
APP_URL=http://localhost:3000

# Better Auth — secret exclusivo por ambiente (gere com: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# URL base do Better Auth (deve coincidir com o host do ambiente)
# Em Preview Vercel: use a URL do deployment (não localhost)
BETTER_AUTH_URL=http://localhost:3000

# Banco PostgreSQL exclusivo da Nova Vida (nunca reutilizar outro projeto)
# development | preview | production
DATABASE_ENV=development
# Runtime (pooler ok)
DATABASE_URL=
# Migrations — OBRIGATÓRIA (sem fallback para DATABASE_URL)
DIRECT_URL=

# Identidade explícita do destino (obrigatória para db:check / migrate / bootstrap)
NV_DB_OWNER=novavida
NV_DB_PROJECT=novavida
NV_DB_BRANCH=dev
NV_DB_NAME=
